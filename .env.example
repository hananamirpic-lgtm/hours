# Copy to .env and fill in real values: cp .env.example .env
# Secrets have no defaults anywhere in the code. A missing value fails startup.

# ---------------------------------------------------------------- application
ENVIRONMENT=local
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jerusalem
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Whether 2FA enrolment is enforced (mandatory for administrators; Requirement 1.6). Leave true in
# any real deployment. Set false only for local development to skip the admin enrolment gate.
REQUIRE_2FA_ENROLMENT=true

# ---------------------------------------------------------------- secrets
# Generate: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
# AES-256 key material. Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# ---------------------------------------------------------------- postgres
POSTGRES_DB=hours
POSTGRES_USER=hours
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
# Host name is the compose service name; use localhost when running outside Docker.
DATABASE_URL=postgresql+psycopg://hours:CHANGE_ME_local_postgres_password@postgres:5432/hours

# ---------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- object storage
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_local_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_local_minio_secret_key
S3_BUCKET_DOCUMENTS=hours-documents

# ---------------------------------------------------------------- mail
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@hours.local

# ---------------------------------------------------------------- scheduled jobs (Requirement 14)
# The in-process scheduler runs the daily notification jobs (no-checkout reminder, over-maximum open
# shift, document expiry) and the weekly missing-report summary. Off by default so the test client
# and a multi-instance deployment do not both fire them; turn it on for a single-instance local run.
# Times are in APP_TIMEZONE; WEEKLY_SUMMARY_WEEKDAY is Monday=0.
#
# In the cloud target the API replicas run with SCHEDULER_ENABLED=false and a dedicated runner fires
# the jobs on the platform schedule instead (`python -m app.jobs_runner daily|weekly`); see
# infra/README.md and infra/RUNBOOK.md.
SCHEDULER_ENABLED=false
DAILY_JOBS_HOUR=18
DAILY_JOBS_MINUTE=0
WEEKLY_SUMMARY_WEEKDAY=0
WEEKLY_SUMMARY_HOUR=7

# ---------------------------------------------------------------- bootstrap admin
# The first administrator, created once by the seed step (python -m app.seed) so a fresh
# deployment has a login that can create every other user. The password is a secret and is never
# stored in a migration; set it here for local use, and supply it from a secrets manager in a real
# deployment. Leave BOOTSTRAP_ADMIN_PASSWORD empty to skip admin creation (for example when the
# admin already exists). Change the password immediately after first sign-in.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_first_admin_password
BOOTSTRAP_ADMIN_LANGUAGE=he

# ---------------------------------------------------------------- frontend
# Target the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://api:8000
