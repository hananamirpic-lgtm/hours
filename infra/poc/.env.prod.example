# ============================================================================
# Production POC environment (single EC2 host, Tel Aviv il-central-1).
#
# Copy this to infra/poc/.env.prod on the EC2 box and fill in real values.
# infra/poc/.env.prod is git-ignored and must NEVER be committed.
#   cp infra/poc/.env.prod.example infra/poc/.env.prod
#   chmod 600 infra/poc/.env.prod
#
# Every value here maps to backend/app/core/config.py. Values marked (AWS) are
# the ones that differ from local and are easy to get wrong on the first move.
# ============================================================================

# ------------------------------------------------------------------ application
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jerusalem

# (AWS) Browser origins allowed to call the API. Use your CloudFront URL.
# No custom domain yet -> the auto-generated distribution domain. Include https://.
# Example: https://d1234abcd.cloudfront.net
CORS_ALLOWED_ORIGINS=https://REPLACE_ME.cloudfront.net

# 2FA enrolment gate stays ON in production. Never set false here.
REQUIRE_2FA_ENROLMENT=true

# ------------------------------------------------------------------ secrets (no defaults; >=32 chars)
# Generate strong random values on the box, e.g.:  openssl rand -base64 48
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_PLUS_CHARS
ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_PLUS_CHARS

# ------------------------------------------------------------------ database (container on /data)
# Postgres runs as a container on this host; data lives on the /data EBS volume.
# The DB is preserved across api/web upgrades. Choose a strong password.
POSTGRES_DB=hours
POSTGRES_USER=hours
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
# The app reads DATABASE_URL; the host is the compose service name "postgres".
DATABASE_URL=postgresql+psycopg://hours:REPLACE_WITH_A_STRONG_DB_PASSWORD@postgres:5432/hours

# ------------------------------------------------------------------ redis (container)
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ object storage (MinIO container)
# MinIO runs on this host. The API reaches it internally at http://minio:9000.
S3_ENDPOINT_URL=http://minio:9000
# (AWS) Presigned URLs are opened by the BROWSER, so this must be a public,
# CloudFront-reachable URL, not the internal container name. For the POC we route
# object access through CloudFront + Caddy at /s3 (see RUNBOOK.md optional step),
# or, simplest for a POC, keep documents flowing through the app. Set this to your
# CloudFront URL if you enable direct browser download of documents.
S3_PUBLIC_ENDPOINT_URL=https://REPLACE_ME.cloudfront.net
S3_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_SECRET_KEY
S3_BUCKET_DOCUMENTS=hours-documents
S3_REGION=il-central-1

# ------------------------------------------------------------------ mail (Amazon SES, il-central-1)
# (AWS) Create SES SMTP credentials (SES console -> SMTP settings -> Create SMTP credentials).
# New SES accounts are in the SANDBOX: verify each of the 10 users' addresses, or
# request production access. Host is the SES SMTP endpoint for Tel Aviv.
SMTP_HOST=email-smtp.il-central-1.amazonaws.com
SMTP_PORT=587
SMTP_FROM_ADDRESS=no-reply@REPLACE_ME_VERIFIED_DOMAIN_OR_ADDRESS
# If your SMTP layer needs auth vars, add them the way app.core.email expects
# (verify the mail client's expected variables before relying on SES auth).

# ------------------------------------------------------------------ scheduled jobs (single instance)
# The in-process scheduler owns the daily/weekly jobs on this single box.
# (Also forced true in docker-compose.prod.yml; kept here for clarity.)
SCHEDULER_ENABLED=true
DAILY_JOBS_HOUR=18
DAILY_JOBS_MINUTE=0
WEEKLY_SUMMARY_WEEKDAY=0
WEEKLY_SUMMARY_HOUR=7

# ------------------------------------------------------------------ security headers
# TLS terminates at CloudFront and Caddy, so emit HSTS.
HSTS_ENABLED=true

# ------------------------------------------------------------------ rate limiting (defaults are fine)
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------ bootstrap admin (first login)
# Set the password ONCE for the very first seed run, then remove it and change the
# password in-app. The seed skips admin creation if the user already exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_FOR_FIRST_SEED_THEN_REMOVE
BOOTSTRAP_ADMIN_LANGUAGE=he

# ------------------------------------------------------------------ images (written by deploy.sh)
# The ECR image URIs the compose overlay pulls. deploy.sh sets these to the tag
# being rolled out; you normally do not edit them by hand.
API_IMAGE=REPLACE_ACCOUNT.dkr.ecr.il-central-1.amazonaws.com/hours-api:vX.Y.Z
WEB_IMAGE=REPLACE_ACCOUNT.dkr.ecr.il-central-1.amazonaws.com/hours-web:vX.Y.Z